{
  "name": "@inseat-labs/fusion",
  "version": "0.1.0",
  "description": "One command: Claude writes, your tests check, Codex reviews, one repair. You get a verified patch in an isolated git worktree and a ledger of which agent delivers in your repo.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "fusion": "./dist/cli/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli/main.js', 0o755)\"",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli/main.ts",
    "plan:examples": "tsx src/cli/main.ts plan examples/tasks/*.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "validate:progress": "tsx src/cli/main.ts validate-events fixtures/progress/valid/*.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/inseat-labs/fusion.git"
  },
  "homepage": "https://fusion.inseat.app",
  "bugs": {
    "url": "https://github.com/inseat-labs/fusion/issues"
  },
  "keywords": [
    "coding-agents",
    "claude-code",
    "codex",
    "orchestration",
    "multi-model"
  ],
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
